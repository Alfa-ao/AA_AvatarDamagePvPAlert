<?xml version="1.0" encoding="UTF-8" ?>
<WidgetTextView>
	<Name>Alert</Name>
	<Placement>
		<X>
			<Align>WIDGET_ALIGN_CENTER</Align>
			<Sizing>WIDGET_SIZING_INTERNAL</Sizing>
		</X>
		<Y>
			<Align>WIDGET_ALIGN_CENTER</Align>
			<Sizing>WIDGET_SIZING_INTERNAL</Sizing>
		</Y>
	</Placement>
	<FormatFileRef href="../Texts/Alert.txt" />
	<TextStyle>
		<multiline>true</multiline>
		<wrapText>false</wrapText>
	</TextStyle>
	<minWidth>100</minWidth>
	<maxWidth>700</maxWidth>
	<TransparentInput>true</TransparentInput>
</WidgetTextView>
