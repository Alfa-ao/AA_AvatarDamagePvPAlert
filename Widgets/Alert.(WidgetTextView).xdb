<?xml version="1.0" encoding="UTF-8" ?>
<WidgetTextView>
	<Name>Alert</Name>
	<Priority>0</Priority>
	<Placement>
		<X>
			<Align>WIDGET_ALIGN_CENTER</Align>
			<Sizing>WIDGET_SIZING_INTERNAL</Sizing>
		</X>
		<Y>
			<Align>WIDGET_ALIGN_LOW</Align>
			<Sizing>WIDGET_SIZING_INTERNAL</Sizing>
			<Pos>250</Pos>
		</Y>
	</Placement>
	<TransparentInput>true</TransparentInput>
	<FormatFileRef href="../Texts/Alert.txt" />
	<TextStyle>
		<wrapText>false</wrapText>
		<showClippedSymbol>true</showClippedSymbol>
	</TextStyle>
	<minWidth>100</minWidth>
	<maxWidth>1200</maxWidth>
	<!-- <PickChildrenOnly>false</PickChildrenOnly>
	<TransparentInput>false</TransparentInput> -->
</WidgetTextView>
